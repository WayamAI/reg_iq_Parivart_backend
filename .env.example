APP_ENV=development
APP_NAME=PARIVART
APP_VERSION=0.1.0

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/parivart

JWT_SECRET=super-secret-key-change-in-prod
JWT_EXPIRES_IN=3600

# Browser origin of the PARIVART frontend.
FRONTEND_ORIGIN=http://localhost:8080
# Extra allowed browser origins, comma-separated. FRONTEND_ORIGIN is always included.
# Set this to your real origins in production. Never use "*" with credentialed requests.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Optional AI enrichment. The Impact Assessment engine is fully deterministic and runs
# without any of this; enrichment only adds a narrative layer when a provider is reachable.
AI_ENRICHMENT_ENABLED=false
AI_PROVIDER=ollama
AI_MODEL=llama3.1
AI_TIMEOUT_SECONDS=20
AI_MAX_ATTEMPTS=1

STORAGE_PROVIDER=local

# Optional Ollama Cloud provider. Disabled by default; requires both an API key and a
# model to actually register (see app/ai/startup.py). To use it, set AI_PROVIDER=ollama_cloud
# above as well. Never commit a real key here -- .env is gitignored; this file is the template.
OLLAMA_CLOUD_ENABLED=false
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=
OLLAMA_CLOUD_CONNECT_TIMEOUT_SECONDS=10.0
OLLAMA_CLOUD_READ_TIMEOUT_SECONDS=60.0

# Accepts ANY email with ANY password and auto-provisions the caller into the demo
# organization. For local demos only. Ignored unless APP_ENV=development, so it cannot
# weaken a real deployment -- but do not ship it set.
DEMO_AUTH_ALLOW_ANY=false
